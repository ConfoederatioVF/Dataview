{
    name: "Eoscala (Economics)",
    open: false,
    synthetic_by_default: true,
    GDP_nominal: {
        name: "GDP (Nominal)",
        unit: "FY$2000",
        filepath: "${h3}GDP_pc/7.scaled_to_national/GDP_${year}.png",
        description: [
            "### GDP (Nominal)",
            "Measured in FY$2000 International Dollars. Nominal conversions do not use PPP deflations and LCU conversions are anchored to the base year. Total per gridcell.",
            "<details>",
            "<summary>Methodology</summary>",
            "Regularised Weighted Least Squares [L2] and dasymetric gravity modelling for years prior to 1800 using population weights. Per capita basis points are estimated first, then multiplied outwards per gridcell.",
            "",
            "__Sources:__ Nordhaus, Maddison Project Database, Gapminder, Kummu et al./SEDAC.",
            "</details>"
        ],
        legend: {
            colourscheme: "rdylgn",
            steepness: 1000
        }
    },
    GDP_nominal_pc: {
        name: "GDP per capita (Nominal)",
        unit: "FY$2000",
        filepath: "${h3}GDP_pc/8.GDP_nominal_pc_rasters/GDP_pc_${year}.png",
        description: [
            "### GDP (Nominal) per capita",
            "Measured in FY$2000 International Dollars. Divides the GDP (Nominal) by Population (Total) per gridcell. Cells with <1ihb are excluded.",
            "Normalised via Tukey's fences.",
            "",
            "See **GDP (Nominal)** for more details."
        ],
        legend: {
            colourscheme: "turbo",
        }
    },
    GDP_PPP: {
        name: "GDP (PPP)",
        unit: "FY$2000",
        filepath: "${h3}GDP_PPP_pc/7.scaled_to_national/GDP_PPP_${year}.png",
        description: [
            "### GDP (PPP)",
            "Measured in FY$2000 International Dollars. PPP deflated and anchored to the base year. Total per gridcell.",
            "<details>",
            "<summary>Methodology</summary>",
            "Regularised Weighted Least Squares [L2] and dasymetric gravity modelling for years prior to 1800 using population weights. Per capita basis points are estimated first, then multiplied outwards per gridcell.",
            "",
            "__Sources:__ Nordhaus, Maddison Project Database, Gapminder, Kummu et al./SEDAC, World Bank (for PPP deflators).",
            "</details>"
        ],
        legend: {
            colourscheme: "rdylgn",
            steepness: 1000
        }
    },
    GDP_PPP_pc: {
        name: "GDP per capita (PPP)",
        unit: "FY$2000",
        filepath: "${h3}GDP_PPP_pc/8.GDP_PPP_pc_rasters/GDP_PPP_pc_${year}.png",
        description: [
            "### GDP (PPP) per capita",
            "Measured in FY$2000 International Dollars. Divides the GDP (PPP) by Population (Total) per gridcell. Cells with <1ihb are excluded.",
            "Normalised via Tukey's fences.",
            "",
            "See **GDP (PPP)** for more details."
        ],
        legend: {
            colourscheme: "turbo"
        }
    },
    gini: {
        name: "Gini (Composite)",
        unit: "%",
        filepath: "${h2}gini_Eoscala/4.output_rasters/gini_${year}.png",
        legend: {
            colourscheme: "cividis",
            type: "linear"
        }
    },
    labourforce: {
        name: "Raw Labourforce",
        category_type: "continuous",
        unit: "Total",
        labourforce_total: {
            name: "Raw Labourforce (Total)",
            category_type: "continuous",
            filepath: "${h2}LFPR_OLS/4.active_labourforce/labourforce_t_${year}.png",
            unit: "Total",
            legend: {
                colourscheme: "plasma"
            }
        },
        labourforce_female: {
            name: "Labourforce (Female)",
            category_type: "continuous",
            filepath: "${h2}LFPR_OLS/4.active_labourforce/labourforce_f_${year}.png",
            unit: "Total",
            legend: {
                colourscheme: "reds"
            }
        },
        labourforce_male: {
            name: "Labourforce (Male)",
            category_type: "continuous",
            filepath: "${h2}LFPR_OLS/4.active_labourforce/labourforce_m_${year}.png",
            unit: "Total",
            legend: {
                colourscheme: "blues"
            }
        }
    },
    lfpr: {
        name: "Labourforce Participation Rate (LFPR)",
        category_type: "continuous",
        unit: "%",
        lfpr_female: {
            name: "Labourforce Participation Rate (LFPR, Female)",
            category_type: "continuous",
            unit: "%",
            filepath: "${h2}LFPR_OLS/3.lfpr_rates/lfpr_f_${year}.png",
            legend: {
                colourscheme: "ylorrd",
                type: "linear"
            }
        },
        lfpr_male: {
            name: "Labourforce Participation Rate (LFPR, Male)",
            category_type: "continuous",
            unit: "%",
            filepath: "${h2}LFPR_OLS/3.lfpr_rates/lfpr_m_${year}.png",
            legend: {
                colourscheme: "ylgnbu",
                type: "linear"
            }
        }
    },
    professions_percentage: {
        name: "Professions (%)",
        unit: "%",
        synthetic_by_default: true,
        filepath: "${prof_per}/${profession}_${gender}_${year}.png",
        description: [
            "### Professions (Percentage)",
            "Estimated sectoral breakdowns per gridcell (agriculture/manufacturing/services/informal labour). Note that labour structures without corresponding state capacity are typically treated as informal labour. This includes non-sedentary work.",
            "",
            "> [!WARNING]",
            "> Uniquely amongst Confoederal datasets, source work here currently involves the encoding of **magic numbers**, which we will be keen to remove in the future. Problem?",
            "",
            "<details>",
            "<summary>Methodology</summary>",
            "Superlearner structure trained on disaggregated ILOSTAT, Olivetti data. This structure was pioneered by [van Dijk et al. 2022](https://doi.org/10.1371/journal.pone.0278120).",
            "",
            "Due to the sparsity of empirical data further back, outputs from hybrid superlearners were then subjected to spatial variance algorithms anchored to estimated historical baselines and Clark-Fisher/[Chenery & Syrquin 1975](https://documents1.worldbank.org/curated/en/482491468328816108/pdf/11913.pdf) modelling, taking into account GDP per capita and urbanisation.",
            "",
            "An additive log ratio (ALR) shift is used to preserve intra-country spatial variance.",
            "</details>"
        ],
        legend: {
            type: "linear"
        },
        variable_selectors: { //There should also be an option to enable all variable selectors
            gender: {
                name: "Gender",
                category_type: "continuous",
                f: {
                    name: "Female"
                },
                m: {
                    name: "Male"
                },
                t: {
                    name: "Total",
                    discounted: true, //Unique category; do not double dip
                }
            },
            profession: {
                name: "Occupation",
                category_type: "continuous",
                agriculture: {
                    name: "Agriculture",
                    legend: {
                        colourscheme: "brbg"
                    }
                },
                informal_labour: {
                    name: "Informal Labour",
                    legend: {
                        colourscheme: "cividis"
                    }
                },
                manufacturing: {
                    name: "Manufacturing",
                    legend: {
                        colourscheme: "viridis"
                    }
                },
                not_in_work: {
                    name: "Not in Work",
                    description: "Unemployment rate within the economically active population (LFPR).",
                    discounted: true,
                    legend: {
                        colourscheme: "rdylgn",
                        inverted: true
                    }
                },
                services: {
                    name: "Services",
                    legend: {
                        colourscheme: "greens"
                    }
                }
            }
        }
    },
    professions_total: {
        name: "Professions",
        synthetic_by_default: true,
        filepath: "${prof_tot}/${profession}_${gender}_${year}.png",
        description: [
            "### Professions (Total)",
            "The total amount of workers in the given sector (agriculture/manufacturing/services/informal labour). Not in work constitutes the population of working age not actively in employment (1 - LFPR), defined as cohorts aged 15-65 (ILO/World Bank definition), stratified by sex. This currently has the weakness of excluding some forms of child labour in earlier periods.",
            "",
            "See methodology in **Professions (%)** for more details."
        ],
        unit: "Total workforce in the selected occupation(s)",
        variable_selectors: { //There should also be an option to enable all variable selectors
            gender: {
                name: "Gender",
                category_type: "continuous",
                f: {
                    name: "Female"
                },
                m: {
                    name: "Male"
                },
                t: {
                    name: "Total",
                    discounted: true, //Unique category; do not double dip
                }
            },
            profession: {
                name: "Occupation",
                category_type: "continuous",
                agriculture: {
                    name: "Agriculture",
                    legend: {
                        colourscheme: "brbg"
                    }
                },
                informal_labour: {
                    name: "Informal Labour",
                    legend: {
                        colourscheme: "cividis"
                    }
                },
                manufacturing: {
                    name: "Manufacturing",
                    legend: {
                        colourscheme: "viridis"
                    }
                },
                not_in_work: {
                    name: "Not in Work",
                    discounted: true,
                    legend: {
                        colourscheme: "rdylgn",
                        inverted: true
                    }
                },
                services: {
                    name: "Services",
                    legend: {
                        colourscheme: "greens"
                    }
                }
            }
        }
    },
    wealth_income: {
        name: "Wealth/Income",
        filepath: "${h3}/wealth_income/1.${indicator}/${indicator}_${year}.png",
        unit: "FY$2000, average household in gridcell",
        variable_selectors: {
            indicator: {
                name: "Indicator",
                category_type: "discrete",
                net_wealth: {
                    name: "Net Wealth",
                    discounted: true
                },
                net_income: {
                    name: "Net Income",
                    discounted: true
                },
                disposable_income: {
                    name: "Disposable Income",
                    discounted: true
                },
                discretionary_income: {
                    name: "Discretionary Income",
                    discounted: true
                }
            }
        }
    }
}