{
  // =========================================================================
  // GeoPNG Dataview Map Configuration (JSON5 format)
  // Edit values directly in this file. Comments & trailing commas supported.
  // =========================================================================
  // Default percentile breaks for quantile scale calculation (comma-separated).
  // Can also be edited live by the user in the sidebar controls.
  defaultPercentileBreaks: "0, 1, 5, 25, 50, 75, 95, 99, 100",
  // Default data layers to enable on startup (de facto borders and Stadestér cities)
  defaultDataLayers: [
    "defacto_borders",
    "stadester"
  ],
  // Touch & interaction picking radius in pixels (used for DeckGL layer hit testing)
  touchPickRadius: 18,
  desktopPickRadius: 2,
  // Camera viewport definitions, graticule settings, and projection pixel offsets.
  // pixelOffset: 0 for standard raster alignment with geographic coordinates.
  mapDefines: {
    initialMercator: {
      longitude: 0,
      latitude: 20,
      zoom: 0.95,
      pitch: 0,
      bearing: 0,
      maxZoom: 18,
      minZoom: 0,
      pixelOffset: 0,
    },
    initialGlobe: {
      longitude: 0,
      latitude: 20,
      zoom: 3,
      pitch: 0,
      bearing: 0,
      maxZoom: 18,
      minZoom: 0,
      pixelOffset: 0,
    },
    initialEquirectangular: {
      target: [
        0,
        0,
        0
      ],
      zoom: 2.83,
      minZoom: 0.2,
      maxZoom: 10,
      pixelOffset: 0,
    },
    initialEqualEarth: {
      target: [
        0,
        0,
        0
      ],
      zoom: 2.80,
      minZoom: 0.2,
      maxZoom: 10,
      pixelOffset: 0,
    },
    graticule: {
      latInterval: 10,
      lngInterval: 20,
      color: [
        255,
        255,
        255,
        40
      ],
    },
  },
  // Basemap Tile Layers
  basemapLayers: [
    {
      id: "dark",
      label: "Dark",
      url: "https://services.arcgisonline.com/arcgis/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}",
    },
    {
      id: "light",
      label: "Light",
      url: "https://services.arcgisonline.com/arcgis/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}",
    },
    {
      id: "satellite",
      label: "Satellite",
      url: "https://services.arcgisonline.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
    },
    {
      id: "topo",
      label: "Topographic",
      url: "https://services.arcgisonline.com/arcgis/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
    },
    {
      id: "none",
      label: "No Basemap (Land / Sea)",
    },
  ],
}