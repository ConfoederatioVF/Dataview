{
  // =========================================================================
  // GeoPNG Dataview Filepath Defines & Root Folders (Single Source of Truth)
  // Edit base server filesystem paths, dataset roots, and pipeline filepaths.
  // Comments and trailing commas are fully supported.
  // =========================================================================
  root_folders: {
    age_sex: "${h3}/age_sex/4.composite_cohorts/",
    alcc: "${h2}/population_KK10LUH2/rasters_KK10LUH2_alcc_km2/",
    c14: "${h2}/population_c14bazAAR/",
    h1: "${nwm}/histmap/1.data_raw/",
    h2: "${nwm}/histmap/2.data_cleaning/",
    h3: "${nwm}/histmap/3.data_transform/",
    h4: "${nwm}/histmap/4.data_exports/",
    h5: "${nwm}/histmap/5.data_visualisation/",
    hyde: "${h2}/landuse_HYDE/rasters/",
    l_atlas: "${l_data}/atlas",
    l_bin: "./bin",
    l_data: "./data",
    l_exports: "./exports",
    l_public_data: "./public/data",
    l_raster_cache: "${l_data}/raster_cache",
    l_stad: "${l_data}/stadester",
    l_stad_cache: "${l_stad}/cache",
    nwm: "${svea}/histmap/",
    prof_per: "${h3}/professions/3.percentages/",
    prof_tot: "${h3}/professions/4.aggregates/",
    stad: "${h2}/population_Stadester/",
    stad_legacy: "${h1}/population_Stadester_Legacy/",
    stad_raw: "${h1}/population_Stadester/",
    stad_vis: "${h5}/stadester/",
    svea: "F:/Active Projects/Project 1509 - SVEA/",
    uf: "${svea}/UF/",
    velk: "${h2}/population_Velkscala/",
    vitals: "${h2}/births_deaths_OLS/",
  },
  filepaths: {
    atlas_cshapes: "${l_atlas}/CShapes-2.0.geojson",
    atlas_dejure: "${l_atlas}/atlas_dejure.naissance",
    atlas_detailed: "${l_atlas}/detailed.naissance",
    atlas_legacy: "${l_atlas}/atlas.naissance",
    atlas_states: "${l_atlas}/temp/states.json",
    baked_demographics: "${l_data}/baked_global_demographics.json",
    baked_sectors: "${l_data}/baked_global_sectors.json",
    native_raster_reader: "${l_bin}/raster_reader.exe",
    natural_earth: "${l_public_data}/ne_50m_admin_0_countries.geojson",
    stadester_bugged_cities: "${l_stad}/bugged_cities.txt",
    stadester_capitals: "${l_stad}/state_capitals.json",
    stadester_city_cache: "${l_stad_cache}/stadester_city_cache.json",
    stadester_coords: "${l_stad}/all_cities_coords.json",
    stadester_ghsl_csv: "${l_stad}/GHSL.csv",
    stadester_legacy_city_cache: "./common/stadester_city_cache.json",
    stadester_metadata: "${l_stad}/city_metadata.json",
    svea_chandler_cities: "${stad_raw}/worldcitypop/chandler_modelski_cities.json",
    svea_populstat_cities: "${stad_raw}/populstat_cities/populstat_cities.json",
    svea_stadester_uud_cities: "${stad_raw}/uud/stadester_cities.json",
    svea_stadester_uud_flattened: "${stad_raw}/uud/flattened_stadester_cities.json",
    svea_stadester_uud_ghsl: "${stad_raw}/uud/stadester_ghsl.json",
    svea_stadester_uud_json: "${stad_raw}/uud/stadester.json",
    svea_stadester_uud_processed: "${stad_raw}/uud/processed_stadester_cities.json",
    svea_stadester_uud_script: "${stad}/stadester_uud.js",
    svea_stadester_vis: "${stad_vis}/stadester_1.1.json",
    uf_date_basic: "${uf}/js/date/date_basic.js",
    uf_date_conversion: "${uf}/js/date/date_conversion.js",
  },
}
