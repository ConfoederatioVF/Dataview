{
  // Target downsampling resolution for raster caching and demographic/sectoral breakdown calculations: [width, height]
  downsampling_resolution: [
    1080,
    540
  ],
  // Downsampling aggregation method to preserve true totals: "sum" (area aggregation), "average", etc.
  downsampling_method: "sum",
  // Whether downsampling optimization is enabled
  enabled: true,
  // Strict RAM & CPU resource caps to prevent builds, compilers, and dev servers from saturating host frames
  resource_limits: {
    // Run heavy compiler processes at BelowNormal OS scheduling priority
    compiler_below_normal_priority: true,
    // Maximum V8 heap allocated to the Stadestér offline/CI compiler (MB)
    compiler_max_heap_mb: 2048,
    // Yield duration (ms) between shard compilations so desktop compositor & audio/UI threads keep scheduling
    compiler_yield_ms: 15,
    // Maximum worker threads used by oxlint
    lint_max_threads: 2,
    // Maximum V8 heap allocated to dev/preview/build server processes (MB)
    server_max_heap_mb: 16384
  },
  // Stadestér multi-million settlement scaling & culling configuration
  stadester_scaling: {
    // Serve existing stale hot_index.bin immediately while recompiling updates in a background worker
    background_recompile: true,
    // Max parallel worker threads for Stage A shard compilation
    compile_concurrency: 4,
    // Use incremental binary columnar spatial-LOD cache instead of monolithic JSON index
    enable_binary_store: true,
    // Stream settlement binary chunks progressively from server (top cities first, then batches)
    enable_progressive_streaming: true,
    // Stream regional/local LOD tiles from server when zoomed past tile_fetch_zoom_threshold
    enable_viewport_tiles: true,
    // Multiplier on maxLabels to bound pre-projection label candidates
    label_candidate_multiplier: 3,
    // Screen-space collision hash cell width and height (pixels)
    label_collision_cell_h: 32,
    label_collision_cell_w: 72,
    // Base global label population floor at zoom 0 (scaled down exponentially with zoom and era scale)
    label_min_pop_base: 500000,
    // Subsequent settlement batch size per progressive HTTP chunk
    stream_chunk_size: 3000,
    // Initial priority settlement batch size flushed immediately to client
    stream_initial_chunk_size: 400,
    // Minimum max_cities budget required to use multi-chunk HTTP streaming (smaller requests use cached gzipped single frame)
    stream_min_cities_threshold: 4001,
    // Zoom threshold at which viewport tile streaming activates for large datasets
    tile_fetch_zoom_threshold: 3.5,
    // Max settlements returned per spatial tile request
    tile_max_cities_per_tile: 2500,
    // Relative log-linear thinning tolerance for binary hot_index.bin population curves (detail packs retain exact records)
    timeseries_log_thin_rel_tol: 0.0025,
    // Minimum interval (ms) between intermediate worker layout commits during spatial chunk streaming
    worker_chunk_coalesce_ms: 120,
    // Max deferral window (ms) for background spatial chunk GPU commits while actively panning or zooming
    worker_defer_during_interaction_ms: 250
  }
}